/* ══════════════════════════════════════════════
   BreathingMinigame.uss
   Estilos para el minijuego de respiracion.
   Edita estos valores para personalizar la UI
   sin tocar el codigo C#.
   ══════════════════════════════════════════════ */

/* Variables de color — cambia aqui para re-temizar */
.root {
    --color-inhale:      rgba(29, 158, 117, 1);
    --color-hold:        rgba(186, 117, 23, 1);
    --color-exhale:      rgba(55, 138, 221, 1);
    --color-bg-inhale:   rgba(29, 158, 117, 0.12);
    --color-bg-hold:     rgba(186, 117, 23, 0.12);
    --color-bg-exhale:   rgba(55, 138, 221, 0.12);
    --color-calm-fill:   rgba(29, 158, 117, 1);
    --color-coin:        rgba(239, 159, 39, 1);
    --color-text:        rgba(30, 30, 30, 1);
    --color-text-muted:  rgba(100, 100, 100, 1);
    --font-size-large:   24px;
    --font-size-medium:  16px;
    --font-size-small:   13px;
    --radius-circle:     50%;
    --radius-pill:       99px;

    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 24px 20px;
    background-color: rgba(0,0,0,0);
}

/* Fondo de fase */
.phase-background {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(29, 158, 117, 0.1);
    transition-property: background-color;
    transition-duration: 0.6s;
}

/* Barra superior */
.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 16px;
}

.phase-info {
    flex-direction: column;
}

.phase-label {
    font-size: var(--font-size-large);
    color: var(--color-text);
    -unity-font-style: bold;
}

.phase-sub {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    margin-top: 2px;
}

/* Monedas */
.coins-box {
    flex-direction: row;
    align-items: center;
    column-gap: 8px;
}

.coin-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-circle);
    background-color: var(--color-coin);
    align-items: center;
    justify-content: center;
}

.coin-symbol {
    font-size: 13px;
    color: rgba(65, 36, 2, 1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.coin-count {
    font-size: var(--font-size-large);
    color: rgba(186, 117, 23, 1);
    -unity-font-style: bold;
}

/* Area de juego */
.game-area {
    width: 100%;
    height: 280px;
    background-color: rgba(245, 245, 242, 0.6);
    border-radius: 12px;
    border-width: 0.5px;
    border-color: rgba(0,0,0,0.1);
    overflow: hidden;
    margin-bottom: 16px;
    position: relative;
}

.curve-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
}

/* Punto guia */
.guide-point {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-circle);
    background-color: var(--color-inhale);
    align-items: center;
    justify-content: center;
    transition-property: background-color;
    transition-duration: 0.5s;
}

.guide-inner {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-circle);
    background-color: rgba(255,255,255,0.9);
}

/* Zona de seguimiento */
.follow-zone {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: var(--radius-circle);
    background-color: rgba(29, 158, 117, 0.18);
    border-width: 1px;
    border-color: rgba(29, 158, 117, 0.35);
    transition-property: background-color, border-color;
    transition-duration: 0.5s;
}

/* Cursor del jugador */
.cursor-dot {
    position: absolute;
    width: 22px;
    height: 22px;
    border-radius: var(--radius-circle);
    background-color: rgba(55, 138, 221, 0.75);
    align-items: center;
    justify-content: center;
}

.cursor-inner {
    width: 9px;
    height: 9px;
    border-radius: var(--radius-circle);
    background-color: rgba(24, 95, 165, 1);
}

/* Calma */
.calm-section {
    width: 100%;
    margin-bottom: 10px;
}

.calm-labels {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
}

.calm-label-text {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
}

.calm-pct {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
}

.calm-track {
    width: 100%;
    height: 10px;
    border-radius: var(--radius-pill);
    background-color: rgba(220, 220, 215, 1);
    overflow: hidden;
}

.calm-fill {
    height: 100%;
    width: 0%;
    border-radius: var(--radius-pill);
    background-color: var(--color-calm-fill);
    transition-property: width, background-color;
    transition-duration: 0.2s;
}

/* Ciclos */
.cycles-label {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    margin-bottom: 14px;
}

/* Boton */
.start-button {
    padding: 10px 36px;
    border-radius: 8px;
    border-width: 0.5px;
    border-color: rgba(0,0,0,0.15);
    background-color: rgba(255,255,255,0.9);
    font-size: var(--font-size-medium);
    color: var(--color-text);
    cursor: url('') auto;
    margin-bottom: 12px;
}

.start-button:hover {
    background-color: rgba(240,240,237,1);
}

/* Panel de completado */
.complete-panel {
    width: 100%;
    padding: 16px;
    border-radius: 10px;
    background-color: rgba(225, 245, 238, 1);
    border-width: 0.5px;
    border-color: rgba(29, 158, 117, 0.3);
    align-items: center;
}

.complete-label {
    font-size: var(--font-size-medium);
    color: rgba(15, 110, 86, 1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hidden {
    display: none;
}

/* Contenedor de monedas animadas */
.coins-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    pointer-events: none;
}

/* Moneda animada individual */
.coin-particle {
    position: absolute;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-circle);
    background-color: var(--color-coin);
    align-items: center;
    justify-content: center;
}

.coin-particle-label {
    font-size: 11px;
    color: rgba(65, 36, 2, 1);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Estados de color por fase — aplicados via C# en .phase-background y .guide-point */
.phase-inhale { background-color: var(--color-bg-inhale); }
.phase-hold   { background-color: var(--color-bg-hold); }
.phase-exhale { background-color: var(--color-bg-exhale); }

.guide-inhale { background-color: var(--color-inhale); }
.guide-hold   { background-color: var(--color-hold); }
.guide-exhale { background-color: var(--color-exhale); }

.zone-inhale  { background-color: rgba(29, 158, 117, 0.18); border-color: rgba(29, 158, 117, 0.35); }
.zone-hold    { background-color: rgba(186, 117, 23, 0.18);  border-color: rgba(186, 117, 23, 0.35); }
.zone-exhale  { background-color: rgba(55, 138, 221, 0.18);  border-color: rgba(55, 138, 221, 0.35); }
